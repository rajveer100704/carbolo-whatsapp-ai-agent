# App Configuration
PORT=8000
HOST=0.0.0.0

# Gemini API Key (Gemini 2.5 Flash / 1.5 Flash)
GEMINI_API_KEY=your-gemini-api-key

# Meta WhatsApp Cloud API Credentials
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
WHATSAPP_VERIFY_TOKEN=your-whatsapp-verify-token

# Google Calendar Credentials
# GOOGLE_SERVICE_ACCOUNT_JSON can be a JSON string of the service account key
GOOGLE_SERVICE_ACCOUNT_JSON={"type": "service_account", ...}
# Or specify a path to the JSON file:
GOOGLE_APPLICATION_CREDENTIALS=credentials/google_service_account.json
# The Calendar ID to check availability and book test drives
GOOGLE_CALENDAR_ID=your-google-calendar-id@group.calendar.google.com
